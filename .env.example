# ==========================================================
# BROWN'S INTERIOR — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in your Supabase keys
# ==========================================================

# 1. Supabase Connection (used by both main website & admin portal)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Email Notification Recipient (receives an email every time a form is submitted)
VITE_NOTIFICATION_EMAIL=brownsinterior.bd@gmail.com

# 3. Optional Web3Forms Access Key (if you prefer Web3Forms over FormSubmit AJAX)
VITE_WEB3FORMS_KEY=
